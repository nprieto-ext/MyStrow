rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /licenses/{uid} {
      // Utilisateur : lecture de SON document uniquement
      allow read: if request.auth != null && request.auth.uid == uid;

      // Creation du document par le client (firebase_client.create_license_doc).
      //
      // ⚠️ CE CHEMIN EST UTILISE PAR LES UTILISATEURS FINAUX :
      // license_manager.register_account() appelle create_license_doc() juste
      // apres sign_up(). Un commentaire precedent affirmait le contraire
      // (« essai 100 % local, seul activate_dev.py passe par la ») — c'est faux,
      // et c'est ce qui avait dispense de tester la regle : toute creation de
      // compte depuis l'application traverse ces lignes.
      //
      // L'ancienne regle ne couvrait la creation que par `allow write`, dont
      // les conditions lisent `resource.data` — or `resource` est null a la
      // creation : la condition tombait en erreur, donc refus.
      //
      // Valeurs bornees : sans ca, autoriser la creation reviendrait a laisser
      // n'importe quel compte s'ecrire un plan 'license' a dix ans.
      //
      // ⚠️ `request.time.toMillis() / 1000` et SURTOUT PAS `request.time.seconds` :
      // sur un timestamp, `seconds` n'est pas l'epoch mais un accesseur de champ
      // inexistant. L'evaluation levait « Type error. Received: [timestamp]
      // Expected: [map,path] », donc la condition entiere tombait en erreur et
      // la creation etait TOUJOURS refusee — inscriptions cassees du 03/08 au
      // 04/08/2026. Le deploiement, lui, passe sans broncher : l'erreur est
      // levee a l'execution, pas a la compilation des regles.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.plan == 'trial'
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.machines.size() == 0
                    && request.resource.data.expiry_utc
                         <= request.time.toMillis() / 1000 + (16 * 86400);

      // Mise a jour LIMITEE a ce que le client ecrit vraiment
      // (firebase_client.py : add_machine / remove_machine / newsletter+lang).
      //
      // Liste BLANCHE et non liste noire. L'ancienne regle figeait seulement
      // plan / expiry_utc / email : tout le RESTE du document restait
      // modifiable par son proprietaire, authentifie comme lui-meme. Il
      // pouvait donc reecrire max_machines (la limite de 2 postes n'est
      // verifiee que cote client) ou updates_until_utc, sans jamais toucher
      // a l'executable.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['machines', 'newsletter_consent', 'lang'])
                    // Limite de postes appliquee cote SERVEUR : le client la
                    // verifiait seul, donc elle ne tenait pas.
                    && request.resource.data.machines.size()
                         <= resource.data.get('max_machines', 2);

      // Suppression jamais autorisee au client : les revocations passent par
      // les Cloud Functions (SDK Admin, non soumis a ces regles).

      // Admin : acces complet
      allow read, write: if request.auth != null
                         && request.auth.token.email == "nicop421@gmail.com";
    }

    match /gdtf_fixtures/{doc} {
      // Lecture PUBLIQUE, comme fixture_packs plus bas : la bibliotheque doit
      // pouvoir etre actualisee par n'importe qui, y compris sans compte.
      //
      // ⚠️ Elle exigeait `request.auth != null`, ce qui contredisait l'intention
      // ET le code appelant (fetch_all_gdtf_fixtures part sans jeton des que le
      // rafraichissement echoue). Consequence en clientele : un utilisateur
      // derriere un antivirus a scan HTTPS n'obtenait plus de jeton, la requete
      // partait anonyme, Firestore repondait 403 — et l'application affichait
      // « Erreur Firestore », sans aucun rapport apparent avec la vraie cause
      // (remontee du 12/08/2026).
      allow read: if true;
      // Ecriture reservee a l'admin (via gdtf_upload Cloud Function)
      allow write: if request.auth != null
                   && request.auth.token.email == "nicop421@gmail.com";
    }

    match /gdtf_library/{doc} {
      // Meta de la bibliotheque (version, lastSync) — lecture authentifiee
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == "nicop421@gmail.com";
    }

    // ⚠️ Les deux blocs ci-dessous existaient en PRODUCTION mais PAS dans ce
    // fichier : deployer l'ancienne version du depot les aurait supprimes, et
    // fixture_packs serait retombe en refus par defaut — packs de fixtures
    // casses pour tous les utilisateurs. Recopies ici a l'identique.
    match /downloads/{docId} {
      allow read: if request.auth != null
                  && request.auth.token.email == "nicop421@gmail.com";
      allow write: if false;
    }

    // Packs de fixtures — lecture publique, ecriture admin uniquement
    match /fixture_packs/{packId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "nicop421@gmail.com";
    }

    // File de moderation des fixtures proposees par les utilisateurs.
    //
    // AUCUNE ecriture client : les depots passent exclusivement par la Cloud
    // Function fixture_submit (SDK Admin, non soumis a ces regles), qui est le
    // seul endroit ou la provenance declaree, l'attestation et le quota
    // journalier sont verifies. Laisser le client ecrire ici contournerait les
    // trois garde-fous d'un coup.
    //
    // Lecture reservee a l'admin : la file contient l'email du contributeur.
    // L'admin panel lit cette collection et y ecrit le statut de la decision
    // (approved / rejected) via l'API REST, donc en passant par ces regles.
    match /fixture_submissions/{submissionId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == "nicop421@gmail.com";
    }

    // Compteurs de quota journalier par utilisateur, tenus par fixture_submit.
    // Rien ni personne cote client ne doit pouvoir les lire ni les remettre a
    // zero : un compteur modifiable par son proprietaire ne serait pas un quota.
    match /fixture_quota/{uid} {
      allow read: if request.auth != null
                  && request.auth.token.email == "nicop421@gmail.com";
      allow write: if false;
    }

  }
}
